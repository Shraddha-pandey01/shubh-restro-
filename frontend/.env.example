# ShubhRestro Frontend Environment Variables Template
#
# In local development:
# Leave VITE_API_URL empty or unset; Vite will automatically proxy /api requests to http://localhost:5000.
#
# In production (e.g. Vercel):
# Set VITE_API_URL in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-backend-app.onrender.com
#
# (Optional) If your real-time socket server is hosted on a separate domain:
# VITE_SOCKET_URL=https://your-backend-app.onrender.com

VITE_API_URL=
VITE_SOCKET_URL=
